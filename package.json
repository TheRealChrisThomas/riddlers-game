{
  "name": "riddlers-game",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Chris Thomas",
  "description": "The Riddler's Game — a co-op escape room built on Temporal. Each case is a durable parent workflow, each chamber a child workflow; player actions are signals and the shared board is a query.",
  "scripts": {
    "temporal": "docker compose up",
    "worker": "tsx watch src/worker.ts",
    "api": "tsx watch src/api.ts",
    "api:reveal": "REVEAL_CODE=1 tsx watch src/api.ts",
    "backend": "concurrently -n worker,api -c cyan,magenta \"npm:worker\" \"npm:api\"",
    "web": "npm --prefix web run dev",
    "dev": "concurrently -n worker,api,web -c cyan,magenta,green \"npm:worker\" \"npm:api\" \"npm:web\""
  },
  "dependencies": {
    "@temporalio/client": "^1.21.0",
    "@temporalio/worker": "^1.21.0",
    "@temporalio/workflow": "^1.21.0",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
